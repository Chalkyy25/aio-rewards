{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": false,
        "final_class": false,
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "phpdoc_align": {
            "align": "left"
        }
    },
    "exclude": [
        "bootstrap/cache",
        "storage",
        "vendor",
        "public"
    ]
}
