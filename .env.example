########################################################################
# AIO Rewards — Environment Configuration Example (placeholders only)
# Copy to .env and fill in real values on the target server.
# Secrets MUST NEVER be committed to the repository.
########################################################################

APP_NAME="AIO Rewards"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL 8) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aio_rewards
DB_USERNAME=aio_rewards
DB_PASSWORD=

# --- Redis (cache / queue / session) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail (SMTP) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="rewards@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Horizon ---
HORIZON_DOMAIN=null
HORIZON_PATH=horizon
HORIZON_DASHBOARD_ALLOWED_IPS=

# --- Two-Factor Authentication ---
TWO_FA_ISSUER="AIO Rewards"

########################################################################
# The following keys are DECLARED here so operators know they exist.
# Values MUST remain in the server environment (.env / systemd EnvironmentFile
# / secrets manager). They are NEVER read from or written to the database.
# Filament System Health only reports presence booleans + derived mode.
########################################################################

# --- Stripe (Phase 3+) — SECRETS ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=gbp

# --- Provider Verification API (Phase 1+) — SECRETS ---
PROVIDER_VERIFICATION_DRIVER=aio_iptv_v1
PROVIDER_VERIFICATION_URL=
PROVIDER_VERIFICATION_KEY=
PROVIDER_VERIFICATION_TIMEOUT=8

# --- Referral cookie (Phase 2+) ---
REFERRAL_COOKIE_NAME=aior_ref
REFERRAL_COOKIE_DAYS=30

# --- Super Admin bootstrap (used by seeder on first deploy only) ---
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME="Super Admin"

VITE_APP_NAME="${APP_NAME}"
